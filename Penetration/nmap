#!/bin/bash

read -p "Enter the IP address or domain to scan: " target_ip


if [ -z "$target_ip" ]; then
    echo "Error: No IP address provided. Exiting."
    exit 1
fi


if ! command -v nmap &> /dev/null; then
    echo "Error: Nmap is not installed. Please install it first (e.g., sudo apt install nmap)."
    exit 1
fi


echo "----------------------------------------"
echo "Starting Nmap scan on: $target_ip"
echo "----------------------------------------"


nmap -sV -Pn "$target_ip"

echo "----------------------------------------"
echo "Scan complete."

